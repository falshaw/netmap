# Copy to .env and replace every value before `docker compose up`.

# PostgreSQL
POSTGRES_USER=netmap
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=netmap

# API key: required on every /api request (X-API-Key) and used to log in to the UI.
# The nginx frontend injects it server-side when proxying /api.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# Key used to encrypt SNMP credentials and the webhook URL at rest (Fernet).
# Any long random string; generate it the same way as API_KEY.
# Changing it makes previously stored credentials unreadable
# (see api/scripts/migrate_crypto.py to re-encrypt).
ENCRYPTION_KEY=

# Host ports (all bound to 127.0.0.1). Change them if they clash with something.
NETMAP_WEB_PORT=3021
NETMAP_API_PORT=8021
NETMAP_DB_PORT=5450

# Optional LLM provider. Scanning, topology and export work without any LLM;
# today it is only used by the Settings page "Test connection" probe.
# For Ollama the model must already be pulled on that host (`ollama pull <model>`),
# otherwise the probe reports it as unavailable.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
# LLM_PROVIDER=claude
# CLAUDE_BRIDGE_URL=http://host.docker.internal:7777
# CLAUDE_MODEL=sonnet
# CLAUDE_BRIDGE_TOKEN=
